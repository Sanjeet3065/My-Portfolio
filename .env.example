# ==============================================================================
# Portfolio Contact Form Email Delivery Configuration
# ==============================================================================
# 1. Sign up for a free Resend account at https://resend.com (3,000 free emails/mo)
# 2. Generate an API Key at https://resend.com/api-keys
# 3. Create a local '.env' file with your real key:
#    RESEND_API_KEY=re_your_api_key_here
#
# IMPORTANT: Never commit your real '.env' file to Git!
# ==============================================================================

# Resend API Key
RESEND_API_KEY=

# Recipient Email (Where you want to receive inquiries)
CONTACT_EMAIL_TO=chauhansanjeet887@gmail.com

# Verified Sender Address
# - Testing / Free Tier default: 'Portfolio Contact <onboarding@resend.dev>'
# - Custom Domain (after DNS verification): 'Portfolio Contact <contact@yourdomain.com>'
CONTACT_EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>
